<style>

</style>

<nav class="navbar navbar-expand-lg bg-body-light border-bottom sticky-top desktop-nav">
  <div class="container-fluid">
    <a class="brand-name" href="/listings"><i class="fa-regular fa-compass"></i>AeroStay</a>

    <form class="search-form tablet-search" role="search" action="/listings" method="GET">
      <input class="form-control me-2 search-inp" name="q" type="search" placeholder="Search Destination" />
      <button class="btn search-btn" type="submit"><i class="fa-solid fa-magnifying-glass"></i>Search</button>
    </form>

    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNavAltMarkup" aria-controls="navbarNavAltMarkup" aria-expanded="false" aria-label="Toggle navigation">
      <i class="fa-solid fa-bars"></i>
    </button>
    
    <div class="collapse navbar-collapse" id="navbarNavAltMarkup">

      <div class="navbar-nav ms-auto collapsible-search">
        <form class="search-form my-2" role="search" action="/listings" method="GET">
          <input class="form-control me-2 search-inp" name="q" type="search" placeholder="Search Destination" />
          <button class="btn search-btn" type="submit"><i class="fa-solid fa-magnifying-glass"></i>Search</button>
        </form>
      </div>

      
      
      <div class="navbar-nav ms-auto align-items-center">
        <a class="nav-link host-link" href="/listings/new">Become a host</a>
        <div class="tax-toggle">
            <div class="form-check-reverse form-switch">
                <input class="form-check-input" type="checkbox" role="switch" id="switchCheckDefault">
                <label class="form-check-label" for="switchCheckDefault">Display total after taxes</label>
            </div>
        </div>
        
        <% if(!currUser) {%>
        <a class="nav-link " aria-current="page" href="/signup"><b>Sign up</b></a>
        <a class="nav-link" href="/login"><b>Log in</b></a>
        <% } %>
        <% if(currUser) {%>
        <a class="nav-link" href="/logout"><b>Log out</b></a>
        <% } %>
      </div>
    </div>
  </div>
</nav>

<!--  MOBILE NAVBAR -->
<nav class="mobile-navbar sticky-top">
    <a class="mobile-brand" href="/listings">
        <i class="fa-regular fa-compass"></i>
    </a>

    <form class="mobile-search-form" role="search" method="GET" action="/listings">
      <div class="search-box">
        <input name="q" type="search" class="mobile-search-inp" placeholder="Search Destinations">
        <button class="mobile-search-btn" type="submit">
            <i class="fa-solid fa-magnifying-glass"></i>
        </button>
      </div>
    </form>

    <button class="menu-btn" data-bs-toggle="collapse" data-bs-target="#mobileMenu">
        <i class="fa-solid fa-bars"></i>
    </button>

</nav>


<div class="collapse mobile-menu-dropdown" id="mobileMenu">

    <a class="menu-link" href="/listings/new">
        Become a Host
    </a>

    <div class="menu-link">
        <div class="form-check form-switch">
            <input class="form-check-input" type="checkbox" id="mobileTaxSwitch">
            <label class="form-check-label" for="mobileTaxSwitch">
                Display total price (incl. GST)
            </label>
        </div>
    </div>

      <% if(typeof currUser === "undefined" || !currUser) { %>
        <a class="menu-link" href="/signup">SignUp</a>
        <a class="menu-link" href="/login">Login</a>
    <% } else { %>
        <a class="menu-link" href="/logout">LogOut</a>
    <% } %>

</div>